# Raw pilot snapshots may contain furnace-local absolute paths. GitHub-bound
# evidence uses sanitized receipts plus path-free metrics/delta summaries.
provenance/raw/
provenance/pilots/**/heartbeat.json
provenance/pilots/**/manifest.json
provenance/pilots/**/RUN_VERIFICATION.json
provenance/pilots/F0_resume_attempt1_failed_model_cache/CONTROL_CONFIG.json
provenance/pilots/F0_resume_attempt1_failed_model_cache/RESUME_CONFIG.json
provenance/pilots/F0_resume_attempt1_failed_model_cache/FAILED.json
